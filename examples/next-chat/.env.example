# Copy to .env.local and fill in a credential for each coding agent you want to use. The harnesses
# pick them up from the environment; only a placeholder of them ever enters the sandbox: a proxy
# outside it swaps the real value in on the way out. Left empty, each harness falls back to
# the login of its own CLI on this machine (`claude`, `codex`), when it finds one.

# Claude Code. A Claude subscription: a long-lived token printed by `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
# Or an Anthropic API key, from https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Codex. An OpenAI API key, from https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Name of the sandbox the example creates once and reuses. Default: ai-sdk-harness-example
# EXAMPLE_SANDBOX_ID=ai-sdk-harness-example
# The Docker Sandboxes CLI. Default: sbx
# SBX_BIN=sbx

# Where the coding agents run: `sbx` (default), a local Docker Sandbox; `microsandbox`, a local
# microVM booted from an OCI image through ai-sdk-sandbox-microsandbox (needs KVM or Apple Silicon);
# `cloud-run`, a Cloud Run sandbox on Google Cloud through ai-sdk-sandbox-cloud-run; or `srt`, this
# machine behind Anthropic Sandbox Runtime through ai-sdk-sandbox-runtime.
# EXAMPLE_SANDBOX=sbx

# With EXAMPLE_SANDBOX=microsandbox: whether the microVM runs a Docker daemon, for `docker` and
# `docker compose`, as a Docker Sandbox does. Read when the sandbox is created. Default: true
# EXAMPLE_MICROSANDBOX_DOCKER=true

# With EXAMPLE_SANDBOX=srt, on Linux: srt needs bubblewrap, socat and ripgrep
# (`sudo apt install bubblewrap socat ripgrep`). Name binaries off the PATH, and run without srt's
# seccomp filter where Ubuntu refuses it: under its bwrap-userns-restrict AppArmor profile (recent
# releases), or with restricted user namespaces (24.04, unless
# `sudo sysctl -w kernel.apparmor_restrict_unprivileged_userns=0`).
# SRT_SOCAT=/usr/bin/socat
# SRT_RIPGREP=/usr/bin/rg
# SRT_ALLOW_ALL_UNIX_SOCKETS=1

# With EXAMPLE_SANDBOX=cloud-run: the URL of the sandbox service, deployed as the README of
# ai-sdk-sandbox-cloud-run explains, and how calls to it are authenticated: `gcloud` (default, the
# gcloud CLI's account, granted roles/run.invoker on the service), `metadata` or `none`. The URL is
# what `gcloud run services describe <service> --format='value(status.url)'` prints.
# CLOUD_RUN_SANDBOX_URL=
# CLOUD_RUN_SANDBOX_AUTH=gcloud
# How long a conversation may stay idle before it is suspended, in milliseconds; on Cloud Run, the
# sandbox itself is suspended once no conversation holds it. Default: 300000 (5 minutes) on Cloud
# Run, where a running sandbox is billed; 900000 (15 minutes) with Docker Sandboxes. 0 never
# suspends.
# EXAMPLE_SUSPEND_AFTER_MS=300000

# A repository the conversations work on, each in a checkout of its own, with what its agent
# changed shown above the conversation: an https: URL, fetched in the sandbox, or the absolute path
# of a repository on this machine, sent to the sandbox as Git bundles. Set it before the first
# conversation: one started without it has no checkout to resume.
# EXAMPLE_REPOSITORY=https://github.com/octocat/Hello-World.git
# The branch or tag to check out. Default: the repository's default branch, or what the repository
# on this machine has checked out.
# EXAMPLE_REPOSITORY_REF=main
# The token of a private https: repository: brokered by the sandbox, never handed to it.
# EXAMPLE_REPOSITORY_TOKEN=
# A command run in each new checkout, before the agent starts.
# EXAMPLE_REPOSITORY_SETUP=npm install

# Where the conversations are kept, as JSON files, resume states included. Default: .data/sessions
# EXAMPLE_SESSIONS_DIR=.data/sessions
