{
  "name": "example-starter-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "prettier": {
    "printWidth": 100,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "scripts": {
    "build": "next build",
    "clean": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\"",
    "dev": "next dev --port 3000",
    "format": "prettier --write \"{app,components,lib}/**/*.{ts,tsx,css}\" \"*.{ts,json,mjs,md}\" \"!next-env.d.ts\"",
    "format:check": "prettier --check \"{app,components,lib}/**/*.{ts,tsx,css}\" \"*.{ts,json,mjs,md}\" \"!next-env.d.ts\"",
    "lint": "eslint .",
    "start": "next start --port 3000",
    "template": "node --env-file-if-exists=.env.local --import tsx scripts/make-template.ts",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.183",
    "@ai-sdk/harness-claude-code": "1.0.187",
    "@ai-sdk/harness-codex": "1.0.185",
    "@ai-sdk/harness-pi": "1.0.186",
    "@ai-sdk/mcp": "2.0.99",
    "@ai-sdk/provider-utils": "5.0.81",
    "@ai-sdk/react": "4.0.176",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-document": "^3.33.1",
    "@tiptap/extension-hard-break": "^3.33.1",
    "@tiptap/extension-mention": "^3.33.1",
    "@tiptap/extension-paragraph": "^3.33.1",
    "@tiptap/extension-text": "^3.33.1",
    "@tiptap/extensions": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/react": "^3.33.1",
    "@tiptap/suggestion": "^3.33.1",
    "ai": "7.0.172",
    "ai-sdk-harness-approval": "^0.2.1",
    "ai-sdk-harness-network": "^0.1.0",
    "ai-sdk-harness-plugins": "^0.3.3",
    "ai-sdk-harness-sessions": "^0.4.4",
    "ai-sdk-harness-workspace": "^0.1.4",
    "ai-sdk-sandbox-cloud-run": "^0.4.2",
    "ai-sdk-sandbox-gce": "^0.5.2",
    "ai-sdk-sandbox-microsandbox": "^0.1.4",
    "ai-sdk-sandbox-runtime": "^0.1.4",
    "ai-sdk-sandbox-sbx": "^0.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.14.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.31",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
