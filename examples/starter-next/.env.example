# Copy to .env.local. Claude Code reads one of these; left empty, it uses the login of the `claude`
# CLI on this machine. Only a placeholder of it enters the sandbox: the Docker Sandboxes proxy swaps
# the real value in on the way to Anthropic.

# A Claude subscription: the long-lived token `claude setup-token` prints.
CLAUDE_CODE_OAUTH_TOKEN=
# Or an Anthropic API key, from https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# The name of the sandbox the conversations share, created once and resumed afterwards.
# SANDBOX_ID=ai-sdk-harness-starter-next
