{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "prettier": "@repo/prettier-config",
  "scripts": {
    "build": "fumadocs-mdx && next build",
    "clean": "repo-clean .next .source out",
    "dev": "fumadocs-mdx && next dev --port 3002",
    "format": "prettier --write \"{app,components,content,lib}/**/*.{ts,tsx,css,json,mdx}\" \"*.{ts,json,mjs}\" \"!next-env.d.ts\"",
    "format:check": "prettier --check \"{app,components,content,lib}/**/*.{ts,tsx,css,json,mdx}\" \"*.{ts,json,mjs}\" \"!next-env.d.ts\"",
    "lint": "eslint .",
    "start": "next start --port 3002",
    "typecheck": "fumadocs-mdx && tsc --noEmit --incremental false"
  },
  "dependencies": {
    "fumadocs-core": "^16.17.7",
    "fumadocs-mdx": "^15.4.9",
    "fumadocs-typescript": "^5.5.2",
    "fumadocs-ui": "^16.17.7",
    "lucide-react": "^1.61.0",
    "mermaid": "^12.1.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.2",
    "@repo/build": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.9.1",
    "eslint-plugin-better-tailwindcss": "^4.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0"
  }
}
