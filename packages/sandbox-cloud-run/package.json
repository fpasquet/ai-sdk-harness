{
  "name": "ai-sdk-sandbox-cloud-run",
  "version": "0.0.0",
  "description": "Cloud Run sandboxes for AI SDK harness agents: Claude Code, Codex and friends on Google Cloud, scaled to zero between turns.",
  "keywords": [
    "ai",
    "ai-sdk",
    "ai-sdk-harness",
    "harness",
    "sandbox",
    "cloud-run",
    "google-cloud",
    "gcp",
    "claude-code",
    "codex",
    "coding-agent"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ai-sdk-sandbox-cloud-run": "./dist/server/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@repo/prettier-config",
  "scripts": {
    "build": "repo-build",
    "clean": "repo-clean dist coverage",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{ts,mjs}\" \"*.{json,md,ts}\" \"!CHANGELOG.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.{ts,mjs}\" \"*.{json,md,ts}\" \"!CHANGELOG.md\"",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "peerDependencies": {
    "@ai-sdk/harness": "^1.0.0",
    "@ai-sdk/provider-utils": "^5.0.0"
  },
  "devDependencies": {
    "@ai-sdk/harness": "^1.0.138",
    "@ai-sdk/provider-utils": "^5.0.53",
    "@repo/build": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^24.13.5",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "zod": "^4.5.4"
  },
  "author": {
    "name": "Fabien Pasquet",
    "url": "https://github.com/fpasquet"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpasquet/ai-sdk-harness.git",
    "directory": "packages/sandbox-cloud-run"
  },
  "homepage": "https://ai-sdk-harness.pages.dev/docs/packages/sandbox-cloud-run",
  "bugs": {
    "url": "https://github.com/fpasquet/ai-sdk-harness/issues"
  }
}
