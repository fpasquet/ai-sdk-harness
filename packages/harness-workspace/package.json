{
  "name": "ai-sdk-harness-workspace",
  "version": "0.1.2",
  "description": "Git workspaces for AI SDK harness agents: a repository checked out in the sandbox, a worktree of its own for each session of Claude Code, Codex and friends, and its changes back as a patch — on any sandbox, credentials kept out of it.",
  "keywords": [
    "ai",
    "ai-sdk",
    "ai-sdk-harness",
    "harness",
    "workspace",
    "git",
    "worktree",
    "patch",
    "sandbox",
    "claude-code",
    "codex",
    "coding-agent"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@repo/prettier-config",
  "scripts": {
    "build": "repo-build",
    "clean": "repo-clean dist coverage",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md,ts}\" \"!CHANGELOG.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md,ts}\" \"!CHANGELOG.md\"",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "peerDependencies": {
    "@ai-sdk/harness": "^1.0.0",
    "ai": "^7.0.0"
  },
  "devDependencies": {
    "@ai-sdk/harness": "^1.0.153",
    "@ai-sdk/harness-claude-code": "^1.0.157",
    "@repo/build": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ai": "^7.0.142",
    "ai-sdk-harness-sessions": "workspace:*",
    "ai-sdk-sandbox-sbx": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "author": {
    "name": "Fabien Pasquet",
    "url": "https://github.com/fpasquet"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpasquet/ai-sdk-harness.git",
    "directory": "packages/harness-workspace"
  },
  "homepage": "https://ai-sdk-harness.pages.dev/docs/packages/harness-workspace",
  "bugs": {
    "url": "https://github.com/fpasquet/ai-sdk-harness/issues"
  }
}
